# --- App ---
APP_ENV=development            # development | production
LOG_LEVEL=INFO
# Origins autorisées (front Vite en local, puis domaine Vercel), séparées par des virgules
CORS_ORIGINS=http://localhost:5173

# --- Supabase (Dashboard > Project Settings > API) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Clé secrète : serveur uniquement, ne jamais l'exposer au front
SUPABASE_SERVICE_ROLE_KEY=
# Vérification des jetons. Si votre projet utilise l'ancien secret partagé (HS256) : Project Settings
# > API > JWT Secret. S'il utilise les nouvelles clés asymétriques, laissez vide (le backend lit
# les clés publiques via SUPABASE_URL).
SUPABASE_JWT_SECRET=

# --- Postgres Supabase (Dashboard > Connect > Connection string) ---
# Format : postgresql://postgres.<ref>:<mot-de-passe>@<host>:6543/postgres
# Port 6543 = pooler (recommandé pour un serveur) ; 5432 = connexion directe
DATABASE_URL=

# --- Connexion de démo du front (jeton « demo.… ») ---
# Les projets créés avec la connexion de démo appartiennent tous à cet utilisateur Supabase,
# créé automatiquement au premier usage. Toujours refusée quand APP_ENV=production.
ALLOW_DEMO_LOGIN=true
DEMO_USER_EMAIL=demo@encadre.invalid

# --- Convocations par e-mail (Resend, https://resend.com) ---
# Sans clé : mode essai, aucun e-mail n'est envoyé (la réponse indique dry_run=true).
RESEND_API_KEY=
# Sans domaine vérifié chez Resend, garder onboarding@resend.dev : il n'envoie qu'à
# l'adresse du compte Resend (pratique pour tester).
EMAIL_FROM=Encadré <onboarding@resend.dev>
# Adresse de réponse par défaut si le réalisateur n'en donne pas dans l'écran Convocations
EMAIL_REPLY_TO=

# --- Anthropic : analyse de scénario (/scenario) et suggestions du Planner ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_EFFORT=medium            # low | medium | high | xhigh | max
SCENARIO_TIMEOUT_SECONDS=90

# --- Scénario et repérage Ollama (local, sans clé Anthropic pour les scénarios) ---
SCENARIO_PROVIDER=anthropic    # anthropic | groq | ollama ; /shot-spec reste sur Anthropic
# OLLAMA_URL et OLLAMA_MODEL : voir la section Sous-titres plus bas (même serveur, même modèle)

# --- Groq (SCENARIO_PROVIDER=groq ; aussi utilisé par le découpage si la clé est remplie) ---
# Offre gratuite : 8 000 jetons par minute. Les appels attendent et réessaient tout seuls.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b                # découpage en scènes (rapide)
GROQ_SCENARIO_MODEL=openai/gpt-oss-120b      # analyse de scénario (/scenario) : le 20b échoue
GROQ_MAX_COMPLETION_TOKENS=4000
GROQ_MAX_BATCH_CHARS=6000                    # monter (ex. 60000) avec l'offre payante

# --- Repérage réel : géocodage + lieux Geoapify (clé serveur uniquement) ---
GEOAPIFY_API_KEY=
SCOUTING_DAILY_PROVIDER_BUDGET=2700
# Open-Meteo gratuit : usage non commercial. Pour usage commercial, configurer l'URL et la clé du plan adapté.
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_API_KEY=

# Compte de démonstration du Kit Festival (scripts/seed_kit_demo.py le crée ou le remet à zéro).
# Mêmes valeurs que VITE_DEMO_EMAIL / VITE_DEMO_PASSWORD dans web/.env (bouton « Continuer en démo »).
DEMO_EMAIL=
DEMO_PASSWORD=

# --- LLM : Gemini (clé gratuite : https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Les modèles gratuits changent : vérifie le nom dans Google AI Studio si l'appel échoue.
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.4
# Version de l'API Gemini (v1beta pour la sortie structurée)
LLM_API_VERSION=v1beta
LLM_TIMEOUT_S=45
# Mettre à true en local pour voir le prompt envoyé et la réponse reçue dans le terminal (jamais en production).
LLM_DEBUG_LOG=false

# Adresse publique du site : le PDF du Passeport imprime <adresse>/verifier/<code>
PUBLIC_APP_URL=http://localhost:5173

# --- Signature C2PA (Passeport IA) ---
# Test : uv run python -m scripts.make_test_cert  puis les trois lignes ci-dessous.
C2PA_CERT_CHAIN_PATH=certs/test-signing-chain.pem
C2PA_PRIVATE_KEY_PATH=certs/test-signing-key.pem
C2PA_SIGNING_ALG=ES256
C2PA_TSA_URL=
# true tant que le certificat est un certificat de test : le passeport le dit. Passer à false en production.
C2PA_TEST_MODE=true
C2PA_TRUST_ANCHORS_PATH=

# --- Catalogue des outils d'IA (recherche automatique quand un outil manque) ---
TOOL_RESOLVE_RATE_LIMIT=10
TOOL_RESOLVE_RATE_WINDOW_S=3600
TOOL_RESEARCH_DAILY_LIMIT=30
TOOL_RESEARCH_CONCURRENCY=2
# Modèle de la recherche d'outils. Vide = LLM_MODEL. Le quota gratuit est compté par modèle : en mettre un
# autre (ex. gemini-3.5-flash) évite que les recherches consomment les requêtes du Coach.
TOOL_RESEARCH_MODEL=
# Lire les sites dont le texte est chargé par JavaScript (navigateur sans écran, local).
# Installation : uv sync --extra browser && uv run playwright install chromium
RESEARCH_BROWSER=false
RESEARCH_BROWSER_CONCURRENCY=2

# Vérification publique d'un PDF (sans compte) : par adresse IP, fichier de 8 Mo au plus, rien n'est conservé
VERIFY_PDF_RATE_LIMIT=30
VERIFY_PDF_RATE_WINDOW_S=3600
VERIFY_PDF_MAX_MB=8
VERIFY_PDF_CONCURRENCY=2

# PDF signé du Passeport : 20 par heure et par utilisateur
PASSPORT_PDF_RATE_LIMIT=20
PASSPORT_PDF_RATE_WINDOW_S=3600
# Limite de /shot-spec par utilisateur (appel LLM)
SHOT_SPEC_RATE_LIMIT=20
SHOT_SPEC_RATE_WINDOW_S=3600

# --- Sous-titres (Kit Festival) ---
# Clé ElevenLabs pour la transcription (Scribe v2). Serveur uniquement, jamais loggée.
# L'audio envoyé est conservé chez ElevenLabs selon leurs conditions.
ELEVENLABS_API_KEY=
# Fournisseur de traduction : gemini (API Google) ou ollama (modèle local, rien ne sort de la machine)
LLM_PROVIDER=gemini
# La traduction Gemini utilise GEMINI_API_KEY ci-dessus. Version gratuite = données de TEST
# uniquement : Google peut utiliser le contenu envoyé.
# Modèle Gemini. Diagnostic du 18/11/2026 sur un lot de 9 lignes : gemini-3.1-flash-lite
# répond en 5,5 s (JSON valide) ; gemini-3.8-flash dépassait 20 s, même pour un seul mot.
GEMINI_MODEL=gemini-3.1-flash-lite
# Modèle de secours, essayé une fois quand le principal reste indisponible (503, 429, délai)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Délai maximal d'un appel Gemini, en secondes (au-delà : nouvel essai, puis secours).
# Chaque appel est aussi borné par le budget restant de la requête, moins 10 s.
GEMINI_TIMEOUT_S=45
# Réflexion du modèle (thinking_level) : minimal | low | medium | high. « minimal » est
# remonté à « low » pour les modèles qui n'ont pas ce niveau (ex. gemini-3.8-flash).
GEMINI_THINKING=minimal
# Adresse du serveur Ollama local
OLLAMA_URL=http://localhost:11434
# Modèle Ollama à utiliser (à télécharger d'abord avec `ollama pull`), ex. qwen3:14b ou gemma3:12b
OLLAMA_MODEL=qwen2.5:7b
# Taille maximale du fichier audio/vidéo envoyé, en Mo (au-delà : erreur 413)
SUBTITLE_MAX_UPLOAD_MB=200
# Délai maximal d'une demande de brouillon de sous-titres, en secondes (au-delà : erreur 504)
SUBTITLE_DRAFT_TIMEOUT_S=180
