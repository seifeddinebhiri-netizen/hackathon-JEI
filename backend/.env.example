# --- App ---
APP_ENV=development            # development | production
LOG_LEVEL=INFO
# Origins autorisées (front Vite en local, puis domaine Vercel), séparées par des virgules
CORS_ORIGINS=http://localhost:5173

# --- Supabase (Dashboard > Project Settings > API) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Clé secrète : serveur uniquement, ne jamais l'exposer au front
SUPABASE_SERVICE_ROLE_KEY=
# Vérification des jetons. Si votre projet utilise l'ancien secret partagé (HS256) : Project Settings
# > API > JWT Secret. S'il utilise les nouvelles clés asymétriques, laissez vide (le backend lit
# les clés publiques via SUPABASE_URL).
SUPABASE_JWT_SECRET=

# --- Postgres Supabase (Dashboard > Connect > Connection string) ---
# Format : postgresql://postgres.<ref>:<mot-de-passe>@<host>:6543/postgres
# Port 6543 = pooler (recommandé pour un serveur) ; 5432 = connexion directe
DATABASE_URL=

# --- LLM : Gemini (clé gratuite : https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Les modèles gratuits changent : vérifie le nom dans Google AI Studio si l'appel échoue.
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.4
# Version de l'API Gemini (v1beta pour la sortie structurée)
LLM_API_VERSION=v1beta
LLM_TIMEOUT_S=45
# Mettre à true en local pour voir le prompt envoyé et la réponse reçue dans le terminal (jamais en production).
LLM_DEBUG_LOG=false
# Limite de /shot-spec par utilisateur (appel LLM)
SHOT_SPEC_RATE_LIMIT=20
SHOT_SPEC_RATE_WINDOW_S=3600

# --- Sous-titres (Kit Festival) ---
# Clé ElevenLabs pour la transcription (Scribe v2). Serveur uniquement, jamais loggée.
# L'audio envoyé est conservé chez ElevenLabs selon leurs conditions.
ELEVENLABS_API_KEY=
# Fournisseur de traduction : gemini (API Google) ou ollama (modèle local, rien ne sort de la machine)
LLM_PROVIDER=gemini
# La traduction Gemini utilise GEMINI_API_KEY ci-dessus. Version gratuite = données de TEST
# uniquement : Google peut utiliser le contenu envoyé.
# Modèle Gemini. Diagnostic du 18/11/2026 sur un lot de 9 lignes : gemini-3.1-flash-lite
# répond en 5,5 s (JSON valide) ; gemini-3.8-flash dépassait 20 s, même pour un seul mot.
GEMINI_MODEL=gemini-3.1-flash-lite
# Modèle de secours, essayé une fois quand le principal reste indisponible (503, 429, délai)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Délai maximal d'un appel Gemini, en secondes (au-delà : nouvel essai, puis secours).
# Chaque appel est aussi borné par le budget restant de la requête, moins 10 s.
GEMINI_TIMEOUT_S=45
# Réflexion du modèle (thinking_level) : minimal | low | medium | high. « minimal » est
# remonté à « low » pour les modèles qui n'ont pas ce niveau (ex. gemini-3.8-flash).
GEMINI_THINKING=minimal
# Adresse du serveur Ollama local
OLLAMA_URL=http://localhost:11434
# Modèle Ollama à utiliser (à télécharger d'abord avec `ollama pull`), ex. qwen3:14b ou gemma3:12b
OLLAMA_MODEL=
# Taille maximale du fichier audio/vidéo envoyé, en Mo (au-delà : erreur 413)
SUBTITLE_MAX_UPLOAD_MB=200
# Délai maximal d'une demande de brouillon de sous-titres, en secondes (au-delà : erreur 504)
SUBTITLE_DRAFT_TIMEOUT_S=180
