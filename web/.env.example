# --- API ---
# Le Coach appelle le backend FastAPI. En local sur ordinateur : http://localhost:8000
# Pour tester sur un TÉLÉPHONE (page en https) : mets /api (le serveur de dev relaie vers le backend).
VITE_API_URL=/api

# true : MODE DÉMO, données simulées (projet, planner, passeport, Kit Festival, sous-titres d'exemple).
# false : vrai backend ; Kit Festival et Passeport IA lus et écrits dans Supabase (compte obligatoire).
VITE_USE_MOCKS=true
# Mode mixte (avec VITE_USE_MOCKS=true) : fonctions de src/api/endpoints.ts qui passent par le vrai backend,
# séparées par des virgules. Vide = tout est simulé. Les sous-titres vont ensemble : nommer createSubtitleDraft
# rend aussi getSubtitleDraft et saveSubtitles réels (le backend exige alors un compte Supabase).
VITE_REAL_ENDPOINTS=searchFestivals,getFestival
# Coach (plan par l'IA) branché au vrai backend. Par défaut : vrai dès que Supabase est configuré.
VITE_REAL_COACH=true
VITE_MOCK_LATENCY_MS=600
VITE_MOCK_FAIL_RATE=0
VITE_PUBLIC_APP_URL=http://localhost:5173

# --- Supabase (Dashboard > Project Settings > API) : connexion réelle ---
# Clé PUBLIQUE (anon) uniquement : jamais la clé service_role ici. Laisse vide pour la connexion simulée.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Compte de démonstration réel (bouton « Continuer en démo ») : mêmes valeurs que DEMO_EMAIL / DEMO_PASSWORD
# dans backend/.env ; le compte est créé ou remis à zéro par : cd backend && uv run python -m scripts.seed_kit_demo
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
